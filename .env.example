# Copie este arquivo para .env.local e preencha com valores reais.
# Nunca commitar .env.local (já coberto pelo .gitignore).
# Ver docs/reference/environment-variables.md para descrição completa de cada variável.

# --- Backend (apps/api) ---
PORT=3001
NODE_ENV=development
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
SWAGGER_ENABLED=true

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_URL=http://localhost:3001
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_EXPENSE_TEMPLATES_ENABLED=false

# --- Supabase / infraestrutura (CI e CLI local) ---
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_ID=
