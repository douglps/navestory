{
  "name": "navestory",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.15.0"
  },
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "lab": "node scripts/lab.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "e2e": "node scripts/e2e.mjs",
    "check:test-pairing": "node scripts/check-test-pairing.mjs",
    "check:hardcoded-colors": "node scripts/check-hardcoded-colors.mjs",
    "db:migrate": "supabase db push",
    "db:generate": "supabase gen types typescript --local > packages/database/src/types.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "turbo": "^2.10.8",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.66.0"
  }
}
